{
  "name": "promo-bot",
  "version": "1.0.0",
  "description": "Oli - Bot: encaminhador de promoções para WhatsApp com links originais",
  "main": "index.js",
  "scripts": {
    "postinstall": "patch-package",
    "setup": "node setup.js",
    "status": "node status.js",
    "start": "npm run setup && node index.js",
    "start:direct": "node index.js",
    "qr": "node generate-qr.js",
    "web": "node web-setup.js",
    "web-auth": "echo '🌐 Abrindo http://localhost:3000 no navegador...' && node web-setup.js",
    "list-groups": "node src/scripts/list-groups.js",
    "test:regex": "node test-regex.js",
    "test:auth": "node test-mercadolivre-auth.js",
    "test:mercadolivre": "node test-mercadolivre-public.js",
    "test:itad": "node test-itad.js",
    "test": "npm run test:regex && npm run test:auth && npm run test:mercadolivre && npm run test:itad",
    "auth:mercadolivre": "node src/scripts/auth-mercadolivre.js",
    "install:browser": "puppeteer browsers install chrome",
    "dev": "node --watch index.js"
  },
  "keywords": [],
  "license": "ISC",
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^4.22.1",
    "patch-package": "^8.0.1",
    "puppeteer": "^24.38.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.34.7"
  }
}
