# ============================================
# CONFIGURAÇÃO DO BOT DE PROMOÇÕES
# ============================================
# Copie este arquivo para .env e preencha os valores
# cp .env.example .env

# IDs dos grupos fonte (separados por vírgula)
# Use: npm run list-groups para descobrir os IDs
# Formato: XXXXXXXXXX@g.us
SOURCE_GROUPS=120363XXXXXXXXXX@g.us,120363YYYYYYYYYY@g.us

# ID do grupo destino (onde as promoções serão enviadas)
DEST_GROUP=120363ZZZZZZZZZZ@g.us

# ============================================
# TELEGRAM — grupos e canais como fonte
# ============================================
# 1. Fale com o @BotFather e use /newbot para criar o bot e pegar o token.
# 2. Ainda no @BotFather: /setprivacy > escolha o bot > Disable.
#    Sem isso o bot não recebe as mensagens dos grupos.
# 3. Adicione o bot em cada grupo de origem. Em canal, ele precisa ser
#    administrador para conseguir ler os posts.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Grupos e canais separados por vírgula. Aceita id numérico (-1001234567890),
# @usuario e link do t.me. Vazio não escuta nada — nunca escuta tudo.
TELEGRAM_SOURCE_CHATS=
# Encaminha a foto do post junto com o texto. Limite de 8 MB por imagem.
TELEGRAM_SEND_IMAGES=true

# ============================================
# ALIEXPRESS — busca por palavra
# ============================================
# Não exige chave, conta de afiliado nem navegador. Diferente do Mercado
# Livre, aqui a busca por termo continua aberta.
ALIEXPRESS_ENABLED=false
# Termos separados por vírgula. Cada um vira uma busca de verdade.
ALIEXPRESS_SEARCHES=placa de video,ssd nvme,teclado mecanico,fone bluetooth,controle xbox
ALIEXPRESS_POLL_MINUTES=60
# O AliExpress vive em promoção; 30% é um piso baixo. Suba se vier ruído.
ALIEXPRESS_MIN_DISCOUNT=30
ALIEXPRESS_MAX_RESULTS=3
# Máximo por termo em cada ciclo. O bot alterna a ordem dos termos.
ALIEXPRESS_MAX_PER_SEARCH=1

# Mercado Livre — Ofertas do Dia (não exige chave, token, OAuth ou navegador)
# A busca por termo saiu: tanto a API quanto lista.mercadolivre.com.br
# passaram a exigir login. O bot lê mercadolivre.com.br/ofertas.
ML_PUBLIC_ENABLED=false
# IDs de categoria do feed de ofertas, separados por vírgula.
# Use "todas" para o feed sem filtro de categoria.
#   MLB1144 Games            MLB1648 Informática    MLB1000 Eletrônicos
#   MLB1051 Celulares        MLB5726 Eletrodomésticos
#   MLB1574 Casa e Decoração MLB1276 Esportes       MLB1246 Beleza
ML_PUBLIC_CATEGORIES=MLB1144,MLB1648
# Filtro opcional por título. Vazio aceita toda oferta da categoria.
# Uma palavra-chave casa quando todas as palavras dela estão no título.
ML_PUBLIC_KEYWORDS=
# Quantas páginas de cada categoria são lidas por ciclo (1 a 5, ~45 itens cada).
ML_PUBLIC_PAGES=2
# Consulta mínima: 15 minutos. Evita muitas chamadas e mensagens repetidas.
ML_PUBLIC_POLL_MINUTES=60
# Só envia item cujo preço anterior indicar ao menos este desconto.
ML_PUBLIC_MIN_DISCOUNT=20
# Máximo total de novas ofertas por consulta.
ML_PUBLIC_MAX_RESULTS=3
# Máximo por categoria em cada consulta. O bot alterna a ordem a cada ciclo.
ML_PUBLIC_MAX_PER_CATEGORY=1

# IsThereAnyDeal (ITAD) — jogos de PC. Use a chave já criada em itad.io.
ITAD_ENABLED=false
ITAD_API_KEY=
ITAD_COUNTRY=BR
ITAD_POLL_MINUTES=60
ITAD_MIN_DISCOUNT=1
ITAD_MIN_STEAM_REVIEWS=100
ITAD_MAX_RESULTS=3
# Lista obrigatória de lojas aceitas: Steam=61, Epic=16, GOG=35, Nuuvem=50.
# Fanatical é bloqueada pelo código mesmo se a API tentar retorná-la.
ITAD_SHOPS=61,16,35,50
ITAD_PRIMARY_SHOPS=61,16
ITAD_EXCLUDE_BUNDLES=true
ITAD_EXCLUDE_ARABIC_TITLES=true

# ============================================
# DELAYS ANTI-BANIMENTO (em milissegundos)
# ============================================

# Delay mínimo e máximo entre mensagens na fila (em ms)
# Padrão: 2 a 5 minutos
QUEUE_DELAY_MIN=120000
QUEUE_DELAY_MAX=300000

# Delay mínimo e máximo de "digitando..." (em ms)
# Padrão: 3 a 8 segundos
TYPING_DELAY_MIN=3000
TYPING_DELAY_MAX=8000

# Intervalo de verificação da fila quando vazia (em ms)
# Padrão: 30 segundos
QUEUE_CHECK_INTERVAL=30000

# ============================================
# CONFIGURAÇÕES GERAIS
# ============================================

# Nível de log: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO
