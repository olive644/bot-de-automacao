# ============================================
# CONFIGURAÇÃO DO BOT DE PROMOÇÕES
# ============================================
# Copie este arquivo para .env e preencha os valores
# cp .env.example .env

# IDs dos grupos fonte (separados por vírgula)
# Use: npm run list-groups para descobrir os IDs
# Formato: XXXXXXXXXX@g.us
SOURCE_GROUPS=120363XXXXXXXXXX@g.us,120363YYYYYYYYYY@g.us

# ID do grupo destino (onde as promoções serão enviadas)
DEST_GROUP=120363ZZZZZZZZZZ@g.us

# ============================================
# TELEGRAM — grupos e canais como fonte
# ============================================
# 1. Fale com o @BotFather e use /newbot para criar o bot e pegar o token.
# 2. Ainda no @BotFather: /setprivacy > escolha o bot > Disable.
#    Sem isso o bot não recebe as mensagens dos grupos.
# 3. Adicione o bot em cada grupo de origem. Em canal, ele precisa ser
#    administrador para conseguir ler os posts.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Grupos e canais separados por vírgula. Aceita id numérico (-1001234567890),
# @usuario e link do t.me. Vazio não escuta nada — nunca escuta tudo.
TELEGRAM_SOURCE_CHATS=
# Encaminha a foto do post junto com o texto. Limite de 8 MB por imagem.
TELEGRAM_SEND_IMAGES=true

# --- Canais públicos, sem precisar do bot dentro deles ---
# Canal público tem uma prévia web em t.me/s/<canal> que o Telegram serve
# já renderizada. Ler dali dispensa bot no canal, permissão de admin e
# login — é o caminho para quem só acompanha canais de promoção.
# Só vale para canal público com @usuario; grupo privado não tem prévia.
TELEGRAM_WEB_ENABLED=false
# Aceita t.me/canal, @canal e canal.
TELEGRAM_WEB_CHANNELS=
# Padrões contidos de propósito: a fila escoa ~17 promoções/hora, e três
# canais a cada 15 min com 2 posts cada produziriam 24/h só de Telegram.
TELEGRAM_WEB_POLL_MINUTES=30
TELEGRAM_WEB_MAX_PER_CHANNEL=1

# Domínios que canais assinam em quase todo post e que não são a oferta.
# O link do produto é sempre preservado; só estes são descartados.
PROMO_LINK_BLOCKLIST=beacons.ai,linktr.ee,linktree.com,chat.whatsapp.com,t.me/joinchat

# ============================================
# QUALIDADE DAS OFERTAS
# ============================================

# Envia a foto do produto junto com a promoção dos coletores.
# A imagem é baixada na hora do envio, não na coleta.
SEND_PRODUCT_IMAGES=true

# So publica o que parece oferta de verdade: precisa ter preco, cupom ou
# um sinal explicito como "50% OFF" ou "frete gratis". Vale para grupos e
# canais de texto livre; os coletores ja vem de feed de ofertas.
ONLY_REAL_OFFERS=true

# Horario de silencio: o bot nao envia NEM COLETA nessa janela. Nao coletar
# e de proposito — nove horas coletando sem enviar acumulariam ~135
# promocoes, que levariam 8h para escoar, e oferta das 3h ja expirou.
QUIET_HOURS_ENABLED=true
QUIET_HOURS_START=21
QUIET_HOURS_END=6
# Aviso enviado ao grupo quando o silencio comeca. Vazio nao avisa.
# {fim} vira o horario de volta.
QUIET_HOURS_NOTICE=🌙 *Cheguei no horário de silêncio.*

Zero notificações até as {fim}. Boa noite!

# Nao repetir a mesma oferta vinda de fontes diferentes. Medido: os codigos
# NATORCIDA, SUPERACHADO e CELULARTECH200 chegavam por dois canais.
DEDUPE_ENABLED=true
DEDUPE_WINDOW_HOURS=72

# Teto da fila. Ao estourar, descarta as de menor desconto.
QUEUE_MAX_SIZE=30
# Marca d'agua aplicada em TODA imagem que vai para o grupo de destino,
# venha ela dos coletores ou dos grupos de origem.
WATERMARK_ENABLED=true
WATERMARK_TEXT=OliBot
# Simbolo ao lado do texto. Deixe vazio para a marca sair so com o texto.
WATERMARK_LOGO=assets/oli-logo.png
# Qualidade do JPEG de saida, de 40 a 100.
WATERMARK_QUALITY=85

# Só publica oferta que chegue perto do menor preço que o bot já viu,
# em vez de confiar no "de:" que a plataforma anuncia. Na primeira vez
# que um produto aparece não há com o que comparar, e ele passa.
PRICE_HISTORY_ENABLED=true
# Margem aceita sobre o menor preço já visto, em porcentagem.
PRICE_HISTORY_TOLERANCE=5

# Autodiagnóstico: avisa no log quando uma fonte ligada para de entregar.
# Vale só para as fontes que consultam sozinhas (Mercado Livre, ITAD,
# AliExpress); WhatsApp e Telegram dependem de alguém publicar, e silêncio
# neles é normal.
HEALTH_REPORT_ENABLED=true
# De quantas em quantas horas o relatório sai.
HEALTH_REPORT_HOURS=6
# Janela que o relatório considera.
HEALTH_WINDOW_HOURS=24

# ============================================
# ALIEXPRESS — busca por palavra
# ============================================
# Não exige chave, conta de afiliado nem navegador. Diferente do Mercado
# Livre, aqui a busca por termo continua aberta.
ALIEXPRESS_ENABLED=false
# Termos separados por vírgula. Cada um vira uma busca de verdade.
ALIEXPRESS_SEARCHES=placa de video,ssd nvme,teclado mecanico,fone bluetooth,controle xbox
ALIEXPRESS_POLL_MINUTES=60
# O AliExpress vive em promoção; 30% é um piso baixo. Suba se vier ruído.
ALIEXPRESS_MIN_DISCOUNT=30
ALIEXPRESS_MAX_RESULTS=3
# Máximo por termo em cada ciclo. O bot alterna a ordem dos termos.
# Anuncio que cobre varias capacidades no titulo (SSD 128GB 256GB 1TB) traz
# o preco da mais barata. Descartar e mais honesto do que avisar: quem le o
# valor em destaque nao confere o anuncio. Descarta ~26% e sobra de sobra.
ALIEXPRESS_SKIP_MULTI_VARIANT=true
ALIEXPRESS_MAX_PER_SEARCH=1

# Mercado Livre — Ofertas do Dia (não exige chave, token, OAuth ou navegador)
# A busca por termo saiu: tanto a API quanto lista.mercadolivre.com.br
# passaram a exigir login. O bot lê mercadolivre.com.br/ofertas.
ML_PUBLIC_ENABLED=false
# IDs de categoria do feed de ofertas, separados por vírgula.
# Use "todas" para o feed sem filtro de categoria.
#   MLB1144 Games            MLB1648 Informática    MLB1000 Eletrônicos
#   MLB1051 Celulares        MLB5726 Eletrodomésticos
#   MLB1574 Casa e Decoração MLB1276 Esportes       MLB1246 Beleza
ML_PUBLIC_CATEGORIES=MLB1144,MLB1648
# Filtro opcional por título. Vazio aceita toda oferta da categoria.
# Uma palavra-chave casa quando todas as palavras dela estão no título.
ML_PUBLIC_KEYWORDS=
# Quantas páginas de cada categoria são lidas por ciclo (1 a 5, ~45 itens cada).
ML_PUBLIC_PAGES=2
# Consulta mínima: 15 minutos. Evita muitas chamadas e mensagens repetidas.
ML_PUBLIC_POLL_MINUTES=60
# Só envia item cujo preço anterior indicar ao menos este desconto.
ML_PUBLIC_MIN_DISCOUNT=20
# Máximo total de novas ofertas por consulta.
ML_PUBLIC_MAX_RESULTS=3
# Máximo por categoria em cada consulta. O bot alterna a ordem a cada ciclo.
ML_PUBLIC_MAX_PER_CATEGORY=1

# IsThereAnyDeal (ITAD) — jogos de PC. Use a chave já criada em itad.io.
ITAD_ENABLED=false
ITAD_API_KEY=
ITAD_COUNTRY=BR
ITAD_POLL_MINUTES=60
ITAD_MIN_DISCOUNT=1
ITAD_MIN_STEAM_REVIEWS=100
# Piso de preco cheio, em reais. Separa jogo de verdade de shovelware
# melhor do que numero de avaliacoes. Use 0 para aceitar qualquer preco.
ITAD_MIN_REGULAR_PRICE=40
ITAD_MAX_RESULTS=3
# Lista obrigatória de lojas aceitas: Steam=61, Epic=16, GOG=35, Nuuvem=50.
# Fanatical é bloqueada pelo código mesmo se a API tentar retorná-la.
ITAD_SHOPS=61,16,35,50
ITAD_PRIMARY_SHOPS=61,16
ITAD_EXCLUDE_BUNDLES=true
ITAD_EXCLUDE_ARABIC_TITLES=true

# ============================================
# DELAYS ANTI-BANIMENTO (em milissegundos)
# ============================================

# Delay mínimo e máximo entre mensagens na fila (em ms)
# Padrão: 2 a 5 minutos
QUEUE_DELAY_MIN=120000
QUEUE_DELAY_MAX=300000

# Delay mínimo e máximo de "digitando..." (em ms)
# Padrão: 3 a 8 segundos
TYPING_DELAY_MIN=3000
TYPING_DELAY_MAX=8000

# Intervalo de verificação da fila quando vazia (em ms)
# Padrão: 30 segundos
QUEUE_CHECK_INTERVAL=30000

# ============================================
# CONFIGURAÇÕES GERAIS
# ============================================

# Nível de log: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO
