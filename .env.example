# ============================================
# CONFIGURAÇÃO DO BOT DE PROMOÇÕES
# ============================================
# Copie este arquivo para .env e preencha os valores
# cp .env.example .env

# IDs dos grupos fonte (separados por vírgula)
# Use: npm run list-groups para descobrir os IDs
# Formato: XXXXXXXXXX@g.us
SOURCE_GROUPS=120363XXXXXXXXXX@g.us,120363YYYYYYYYYY@g.us

# ID do grupo destino (onde as promoções serão enviadas)
DEST_GROUP=120363ZZZZZZZZZZ@g.us

# ============================================
# DELAYS ANTI-BANIMENTO (em milissegundos)
# ============================================

# Delay mínimo e máximo entre mensagens na fila (em ms)
# Padrão: 2 a 5 minutos
QUEUE_DELAY_MIN=120000
QUEUE_DELAY_MAX=300000

# Delay mínimo e máximo de "digitando..." (em ms)
# Padrão: 3 a 8 segundos
TYPING_DELAY_MIN=3000
TYPING_DELAY_MAX=8000

# Intervalo de verificação da fila quando vazia (em ms)
# Padrão: 30 segundos
QUEUE_CHECK_INTERVAL=30000

# ============================================
# CONFIGURAÇÕES GERAIS
# ============================================

# Nível de log: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO
